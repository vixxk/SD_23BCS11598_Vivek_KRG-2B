    <mxGraphModel dx="1188" dy="703" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="VWZiYS4LC1N6ijENlrWA-2" value="Q) Design a hotstar like application with following requirements:&lt;br&gt;1. User Login Service&lt;div&gt;2. Subscribe Service&lt;/div&gt;&lt;div&gt;3. Movie / TV Show Search Service&lt;/div&gt;&lt;div&gt;4. Movie / TV Show Play Service&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Optimize the application using CDC Pipeline, highlight where proxy design&amp;nbsp;&lt;/div&gt;&lt;div&gt;pattern can be used.&lt;br&gt;Use HLS and DASH for specific live / static content playing along with manifest file.&amp;nbsp;&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="430.77" y="100" width="470" height="140" as="geometry" />
        </mxCell>
        <mxCell id="VWZiYS4LC1N6ijENlrWA-3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;fontStyle=0;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1">
          <mxGeometry x="90" y="957" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="VWZiYS4LC1N6ijENlrWA-4" value="Functional Requirements:&amp;nbsp;&lt;div&gt;1) User should be able to register/login&lt;/div&gt;&lt;div&gt;2) User should be able to subscribe to any subscription&lt;/div&gt;&lt;div&gt;3) User should be able to make payment for the subscription&lt;/div&gt;&lt;div&gt;4) User should be able to play any video which is pre-recorded (DASH)&lt;br&gt;&lt;div&gt;5) User should be able to livestream any live video (HLS)&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="290.77" y="310" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="VWZiYS4LC1N6ijENlrWA-5" value="Non-Functional Requirements:&lt;div&gt;1) Latency &amp;lt;50ms (Live Streaming)&lt;/div&gt;&lt;div&gt;2) System should be highly available&lt;/div&gt;&lt;div&gt;3) Adaptive Streaming Video quality&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;4) Highly consistent for payments&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;5) Scalability is possible&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="774.13" y="300" width="220" height="110" as="geometry" />
        </mxCell>
